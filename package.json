{
  "name": "velo-lhr",
  "version": "1.0.1",
  "description": "Velo.LHR — Progressive Web App for finding hotels near Heathrow Airport",
  "main": "public/index.html",
  "scripts": {
    "build": "node scripts/generate-version.js",
    "deploy": "aws s3 sync public/ s3://velo-lhr-bucket --delete",
    "invalidate": "aws cloudfront create-invalidation --distribution-id $CF_DIST_ID --paths '/*'",
    "start": "npx serve public -l 3000"
  },
  "keywords": [
    "pwa",
    "heathrow",
    "hotels",
    "aws",
    "cloudfront",
    "velo-lhr"
  ],
  "author": "VeloSights",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.2.1"
  }
}